{
  "kind": "collectionType",
  "collectionName": "paginas",
  "info": {
    "singularName": "pagina",
    "pluralName": "paginas",
    "displayName": "Página",
    "description": "Páginas estáticas y bloques de contenido general"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "titulo": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 200
    },
    "slug": { "type": "uid", "targetField": "titulo", "required": true },
    "contenido": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "richtext"
    },
    "tipo": {
      "type": "enumeration",
      "enum": ["nosotros", "postventa", "financiamiento", "privacidad", "terminos", "faq"],
      "required": true
    },
    "activa": { "type": "boolean", "default": true },
    "seoTitle": { "type": "string", "maxLength": 70 },
    "seoDescription": { "type": "text", "maxLength": 160 }
  }
}
