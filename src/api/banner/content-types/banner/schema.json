{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner",
    "description": "Banners y sliders del home y páginas internas"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "titulo": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 200
    },
    "subtitulo": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "text",
      "maxLength": 300
    },
    "descripcion": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "text",
      "maxLength": 500
    },
    "imagenDesktop": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "imagenMobile": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "ctaTexto": { "type": "string", "maxLength": 100 },
    "ctaUrl": { "type": "string", "maxLength": 500 },
    "orden": { "type": "integer", "min": 0, "default": 0 },
    "activo": { "type": "boolean", "default": true }
  }
}
