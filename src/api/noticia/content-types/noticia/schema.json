{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Noticia",
    "description": "Noticias y blog de Foton Chile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "titulo": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "string",
      "required": true,
      "minLength": 5,
      "maxLength": 300
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "bajada": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "text",
      "maxLength": 500
    },
    "contenido": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "richtext"
    },
    "imagenPrincipal": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "categoria": {
      "type": "enumeration",
      "enum": ["empresa", "productos", "electromovilidad", "postventa", "internacional", "eventos"]
    },
    "fechaPublicacion": { "type": "datetime" },
    "autor": { "type": "string", "maxLength": 200 },
    "destacada": { "type": "boolean", "default": false },
    "activa": { "type": "boolean", "default": true },
    "seoTitle": { "type": "string", "maxLength": 70 },
    "seoDescription": { "type": "text", "maxLength": 160 }
  }
}
