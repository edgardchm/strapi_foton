{
  "kind": "collectionType",
  "collectionName": "soluciones",
  "info": {
    "singularName": "solucion",
    "pluralName": "soluciones",
    "displayName": "Solución",
    "description": "Soluciones de transporte Foton Chile"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "titulo": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 200
    },
    "slug": { "type": "uid", "targetField": "titulo", "required": true },
    "descripcion": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "richtext"
    },
    "imagen": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "icono": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "categoria": {
      "type": "enumeration",
      "enum": ["urbano", "distribucion", "industrial", "construccion", "electromovilidad", "flotas"]
    },
    "orden": { "type": "integer", "min": 0, "default": 0 },
    "activa": { "type": "boolean", "default": true }
  }
}
