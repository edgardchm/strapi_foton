{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "FAQ",
    "description": "Preguntas frecuentes de Foton Chile"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "pregunta": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "string",
      "required": true,
      "minLength": 5,
      "maxLength": 500
    },
    "respuesta": {
      "pluginOptions": { "i18n": { "localized": true } },
      "type": "richtext",
      "required": true
    },
    "categoria": { "type": "string", "maxLength": 100 },
    "orden": { "type": "integer", "min": 0, "default": 0 },
    "activa": { "type": "boolean", "default": true }
  }
}
