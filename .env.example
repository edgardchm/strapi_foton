# =====================================================
# FOTON CMS — Strapi v4.25.9 — Environment Variables
# Copiar como .env y completar valores reales
# NUNCA subir .env al repositorio
# =====================================================

# === CORE ===
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_KEYS=change_me_key1,change_me_key2,change_me_key3,change_me_key4
API_TOKEN_SALT=change_me_api_token_salt_32chars
ADMIN_JWT_SECRET=change_me_admin_jwt_secret_32chars
JWT_SECRET=change_me_jwt_secret_32chars
TRANSFER_TOKEN_SALT=change_me_transfer_token_salt

# === DATABASE — PostgreSQL 12+ (On-Premise / Azure Database for PostgreSQL) ===
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=foton_strapi
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me_strong_password
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Azure Database for PostgreSQL (producción):
# DATABASE_HOST=kaufmann-postgresql.postgres.database.azure.com
# DATABASE_USERNAME=postgres@kaufmann-postgresql
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# === ADMIN ===
ADMIN_PATH=/admin
API_LIMIT_PAGINATION_LIMIT_DEFAULT=25
API_LIMIT_PAGINATION_LIMIT_MAX=100

# === IMPORTACIÓN EXCEL ===
MAX_IMPORT_FILE_SIZE=5242880
ALLOWED_IMPORT_TYPES=xlsx,xls

# === EMAIL (opcional) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@fotonchile.cl

# === LOGGING ===
LOG_LEVEL=info

# === CORS (producción) ===
CORS_ORIGIN=http://localhost:4200,https://fotonchile.cl
